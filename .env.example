APP_NAME="DimsElektro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB)
# ---------------------------------------------------------------------------
# The application is designed to run on MySQL 8+ (or MariaDB 10.4+).
# Leave DB_SOCKET empty unless you want to connect through a unix socket.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dimselektro
DB_USERNAME=dimselektro
DB_PASSWORD=

# Database used by the automated test suite (see phpunit.xml)
DB_TEST_DATABASE=dimselektro_test

# ---------------------------------------------------------------------------
# Session / cache / queue
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Product images are stored on the "public" disk (php artisan storage:link)
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Payment gateway
# ---------------------------------------------------------------------------
# "fake"    -> local/manual gateway, no external calls (default, no keys needed)
# "midtrans"-> Midtrans adapter. NOT configured by default; the application
#              must keep working when these values are empty.
PAYMENT_GATEWAY=fake
PAYMENT_CURRENCY=IDR

MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# ---------------------------------------------------------------------------
# Store behaviour
# ---------------------------------------------------------------------------
STORE_LOW_STOCK_THRESHOLD=5

VITE_APP_NAME="${APP_NAME}"
